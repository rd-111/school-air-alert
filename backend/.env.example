# Set true for local in-memory repositories and the clearly named demo school.
USE_MEMORY_DB=false
AWS_REGION=ap-south-1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
FORECAST_CACHE_TTL_SECONDS=300
PM25_GREEN_MAX=60
PM25_YELLOW_MAX=120
PM25_SENSITIVE_GREEN_MAX=40
PM25_SENSITIVE_YELLOW_MAX=90

SCHOOLS_TABLE=
SUBSCRIBERS_TABLE=
NOTIFICATION_RUNS_TABLE=
HISTORY_TABLE=
BEDROCK_MODEL=
# Replace only in a local untracked .env file or deployment parameters.
TELEGRAM_TOKEN=replace-with-bot-token
TELEGRAM_SECRET=replace-with-webhook-secret
